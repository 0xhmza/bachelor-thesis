# Auto detect text files and perform LF normalization
* text=auto

# Source files are text
*.tex   text
*.bib   text
*.md    text
*.cls   text
*.sty   text

# Never touch these
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.xlsx  binary
*.docx  binary
*.zip   binary
*.mp4   binary

# Git hooks run under sh: keep LF line endings
scripts/hooks/*  text eol=lf
*.sh             text eol=lf
