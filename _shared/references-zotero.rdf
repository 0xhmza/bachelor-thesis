  <rdf:Description rdf:about="#item_mcgowan2016press">
    <z:itemType>journalArticle</z:itemType>
    <dc:title>PRESS Peer Review of Electronic Search Strategies: 2015 Guideline Statement</dc:title>
    <bib:authors><rdf:Seq>
      <rdf:li><foaf:Person>
        <foaf:surname>McGowan</foaf:surname>
        <foaf:givenName>Jessie</foaf:givenName>
      </foaf:Person></rdf:li>
      <rdf:li><foaf:Person>
        <foaf:surname>Sampson</foaf:surname>
        <foaf:givenName>Margaret</foaf:givenName>
