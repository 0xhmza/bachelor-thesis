# ----------------------------------------------------------------------
#  latexmkrc — build settings for both proposal versions.
# ----------------------------------------------------------------------
#  Same chain as the thesis: pdflatex -> biber -> pdflatex x2, built in
#  place. Both versions share ../_shared/references.bib.
# ----------------------------------------------------------------------

$pdf_mode              = 1;                # 1 = pdflatex
$synctex               = 1;
$interaction           = 'nonstopmode';
$file_line_error_style = 1;

# A bare `latexmk` here builds both versions of the proposal.
@default_files = ('proposal.tex', 'proposal_short.tex');

$clean_ext = '%R.bcf %R.run.xml';
