# ----------------------------------------------------------------------
#  latexmkrc — full thesis build; automatic previews use PDFLaTeX directly.
# ----------------------------------------------------------------------
#  latexmk reads this file automatically when it runs in this directory,
#  which means TeXstudio (F5, configured as latexmk + PDF viewer), the
#  LaTeX Workshop recipe, a bare `latexmk` in a terminal and ../build.ps1
#  all compile the thesis the same way. Run only one of them at a time:
#  two builds in this folder overwrite each other's thesis.aux.
#
#      pdflatex -> bibtex -> pdflatex -> pdflatex
#
#  latexmk detects bibliography changes and runs BibTeX only when needed.
#
#  Everything is built in place, so thesis.pdf stays here next to
#  thesis.tex (this repository tracks that PDF).
# ----------------------------------------------------------------------

$pdf_mode              = 1;                # 1 = pdflatex
$synctex               = 1;                # editor <-> PDF jumping
$interaction           = 'nonstopmode';
$file_line_error_style = 1;                # parseable "file:line: message"

# A bare `latexmk` builds the thesis, not every *.tex in the folder.
@default_files = ('thesis.tex');
