{
  // =====================================================================
  //  LaTeX Workshop — thesis workspace
  // =====================================================================
  //  Engine        : pdflatex + biber (biblatex, see config/preamble.tex)
  //  Bibliography  : references.bib (in this folder)
  //  Build output  : in place, next to the sources — the same place
  //                  TeXstudio and ../build.ps1 write it, so the tracked
  //                  thesis.pdf never moves.
  //  TeX Live 2025 : C:\texlive\2025\bin\windows (on the user PATH)
  //
  //  The same chain is defined for plain `latexmk` in ./latexmkrc, so
  //  editor, CLI and CI all agree. Change the build there first.
  // =====================================================================

  // ---------------------------------------------------------------- tools
  // Absolute commands are not needed: TeX Live is on the user PATH.
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-pdf",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ]
    },
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ]
    },
    {
      "name": "biber",
      "command": "biber",
      "args": ["%DOCFILE%"]
    }
  ],

  // -------------------------------------------------------------- recipes
  // latexmk reads the .bcf file and inserts biber on its own, so the first
  // recipe is the normal one. The second mirrors TeXstudio's fixed chain.
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (pdflatex + biber)",
      "tools": ["latexmk"]
    },
    {
      "name": "pdflatex -> biber -> pdflatex x2",
      "tools": ["pdflatex", "biber", "pdflatex", "pdflatex"]
    }
  ],
  "latex-workshop.latex.recipe.default": "latexmk (pdflatex + biber)",

  // Build next to the sources — never into a separate output directory.
  "latex-workshop.latex.outDir": "%DIR%",

  // ------------------------------------------------------- build triggers
  // "onSave" rebuilds on every .tex save. After editing references.bib
  // either save any .tex file or build once with Ctrl+Alt+B.
  "latex-workshop.latex.autoBuild.run": "onSave",
  // Do not silently wipe aux files and start over when a build fails —
  // a broken .tex should surface as an error, not as a slow rebuild.
  "latex-workshop.latex.autoBuild.cleanAndRetry.enabled": false,
  // Show which file is compiled as the root document in the status bar.
  "latex-workshop.latex.build.rootfileInStatus": true,

  // ------------------------------------------------------------ aux files
  // Nothing is deleted automatically, so incremental builds stay fast.
  // "Clean up auxiliary files" uses globs and only ever matches
  // thesis.<ext> files: sources and thesis.pdf are never touched.
  "latex-workshop.latex.autoClean.run": "never",
  "latex-workshop.latex.clean.method": "glob",
  "latex-workshop.latex.clean.subfolder.enabled": false,
  "latex-workshop.latex.clean.fileTypes": [
    "%DOCFILE%.aux",
    "%DOCFILE%.bbl",
    "%DOCFILE%.bcf",
    "%DOCFILE%.blg",
    "%DOCFILE%.fdb_latexmk",
    "%DOCFILE%.fls",
    "%DOCFILE%.idx",
    "%DOCFILE%.ind",
    "%DOCFILE%.lof",
    "%DOCFILE%.log",
    "%DOCFILE%.lot",
    "%DOCFILE%.nav",
    "%DOCFILE%.out",
    "%DOCFILE%.run.xml",
    "%DOCFILE%.snm",
    "%DOCFILE%.synctex(busy)",
    "%DOCFILE%.synctex.gz(busy)",
    "%DOCFILE%.toc",
    "%DOCFILE%.vrb",
    "%DOCFILE%.xdv",
    // left behind by latexindent when the document is formatted
    "indent.log"
  ],

  // ------------------------------------------------------ multi-file setup
  // thesis.tex is the only \documentclass in here; config/, chapters/ and
  // appendix/ hold \input-ed fragments only, so root detection has nothing
  // to disambiguate. \subfiles is not used.
  "latex-workshop.latex.rootFile.useSubFile": false,

  // ------------------------------------------------- bibliography support
  // The single .bib (references.bib) sits in this folder, next to thesis.tex.
  "latex-workshop.latex.bibDirs": ["${workspaceFolder}"],
  "latex-workshop.intellisense.citation.backend": "biblatex",
  "latex-workshop.intellisense.citation.label": "title",
  "latex-workshop.intellisense.citation.format": [
    "author",
    "title",
    "journal",
    "booktitle",
    "year"
  ],

  // ------------------------------------------------------ editor behaviour
  "latex-workshop.view.pdf.viewer": "tab",
  // SyncTeX is enabled in the tools above; do not steal focus after a build.
  "latex-workshop.synctex.afterBuild.enabled": false,
  // Overfull boxes matter for a printed thesis, underfull ones are noise.
  "latex-workshop.message.badbox.show": "overfull",

  "[latex]": {
    "editor.wordWrap": "on",
    "editor.tabSize": 2,
    "editor.defaultFormatter": "James-Yu.latex-workshop"
  },
  "[bibtex]": {
    "editor.wordWrap": "on",
    "editor.tabSize": 2
  }
}
