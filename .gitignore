# ---------- LaTeX build output ----------
build/
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.lof
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
*.nav
*.snm
*.vrb
*.xdv
*.idx
*.ilg
*.ind

# latexindent (LaTeX Workshop's formatter) writes this next to the document
indent.log
indent.log.*

# Keep the compiled PDFs of the actual documents
!03_Thesis/proposal/proposal.pdf
!03_Thesis/thesis.pdf
!06_Presentation/slides.pdf

# ---------- TeXstudio ----------
*.txss2
.texstudio/

# ---------- Obsidian ----------
# The vault opens fine without these; workspace.json churns on every pane move.
.obsidian/

# ---------- Syncthing ----------
*.sync-conflict-*
.stversions/

# ---------- Office / OS temp ----------
~$*
.DS_Store
Thumbs.db
desktop.ini

# ---------- Python (scraping / analysis) ----------
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# ---------- Study data ----------
# Raw participant / scraped data is never committed.
05_Data/raw/*
!05_Data/raw/.gitkeep
!05_Data/raw/README.md
/tmp

# ---------- Graphify local state ----------
.codex/hooks.json
graphify-out/cache/
graphify-out/.graphify_*
graphify-out/.chunk-*
graphify-out/.build_*
graphify-out/memory/
graphify-out/reflections/
